{
  "name": "@claude-viz/daemon",
  "version": "0.1.0",
  "description": "Background daemon for collecting and storing Claude CLI data",
  "main": "dist/index.js",
  "bin": {
    "claude-viz-daemon": "dist/index.js"
  },
